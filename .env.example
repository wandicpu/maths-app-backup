# ==========================================================
# OPTIONAL settings. The app works 100% offline without any
# of these. Copy this file to ".env" and fill in only what
# you want to switch on, then restart `npm run dev`.
# ==========================================================

# --- Cloud accounts + scores dashboard (Supabase) ---
# Project Settings -> API, in your free supabase.com project
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Email verification codes (EmailJS) ---
# Only needed if you want email sign-up codes. Get these at emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Feedback / reviews from users (choose ONE) ---
# Easiest: leave these blank and host on Netlify — the Feedback form is picked up
# automatically and submissions appear in your Netlify dashboard (Forms tab).
#
# Or use Web3Forms (free, emails you): make a key at web3forms.com and paste it:
VITE_WEB3FORMS_KEY=
# Email used only as a last-resort fallback if neither option above is set:
VITE_FEEDBACK_EMAIL=
